{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TablaPuntajes",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/Puntajes"
    },
    {
      "Sid": "ColaEnviar",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:puntajes"
    },
    {
      "Sid": "ColaConsumir",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:puntajes"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/*",
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/*:*"
      ]
    }
  ]
}
